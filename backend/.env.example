# REQUIRED: Anthropic API Key
ANTHROPIC_API_KEY=sk-ant-your-key-here

# REQUIRED: Secret key for JWT tokens (generate with: openssl rand -hex 32)
SECRET_KEY=your-secret-key-here

# Database Configuration
DATABASE_URL=postgresql://meta_analysis:password@localhost:5432/meta_analysis_db
# For SQLite (development):
# DATABASE_URL=sqlite:///./meta_analysis.db

# Redis Configuration
REDIS_URL=redis://localhost:6379/0

# Optional: OpenAI API Key
OPENAI_API_KEY=

# Optional: PubMed API Configuration
PUBMED_API_KEY=
PUBMED_EMAIL=

# Application Settings
DEBUG=false
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000

# Security Settings
ACCESS_TOKEN_EXPIRE_MINUTES=30
ALGORITHM=HS256

# CORS Settings
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# Feature Flags
ENABLE_VOICE=false
ENABLE_LEARNING=true
ENABLE_VERIFICATION=true

# Paths
TEMP_DIR=./temp
DATA_DIR=./data
DOWNLOADS_DIR=./downloads
CHROMA_PERSIST_DIR=./data/chroma
