# Multi-stage Dockerfile for Celery Background Workers
# For compute-intensive tasks: data extraction, statistical analysis, network analysis

# ============================================================================
# Stage 1: Builder - Install dependencies including heavy ML/scientific packages
# ============================================================================
FROM python:3.11-slim AS builder

WORKDIR /build

# Install build dependencies for scientific packages
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    g++ \
    gfortran \
    libpq-dev \
    libopenblas-dev \
    liblapack-dev \
    pkg-config \
    && rm -rf /var/lib/apt/lists/*

# Copy requirements
COPY requirements.worker.txt ./

# Install Python dependencies to a virtual environment
RUN python -m venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

# Install dependencies (including scipy, numpy, pandas for statistical work)
RUN pip install --no-cache-dir --upgrade pip setuptools wheel && \
    pip install --no-cache-dir -r requirements.worker.txt

# ============================================================================
# Stage 2: Runtime - Worker with scientific libraries
# ============================================================================
FROM python:3.11-slim

# Set environment variables
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PATH="/opt/venv/bin:$PATH" \
    C_FORCE_ROOT=true

WORKDIR /app

# Install runtime dependencies including R for meta-analysis
RUN apt-get update && apt-get install -y --no-install-recommends \
    libpq5 \
    libopenblas0 \
    libgomp1 \
    r-base \
    r-base-dev \
    && rm -rf /var/lib/apt/lists/* \
    && apt-get clean

# Install R packages for meta-analysis
RUN R -e "install.packages(c('metafor', 'meta', 'ggplot2'), repos='http://cran.rstudio.com/')"

# Copy virtual environment from builder
COPY --from=builder /opt/venv /opt/venv

# Copy application code
COPY app ./app

# Create non-root user for security
RUN useradd -m -u 1000 worker && \
    chown -R worker:worker /app && \
    mkdir -p /app/logs /app/data /app/temp && \
    chown -R worker:worker /app/logs /app/data /app/temp

# Switch to non-root user
USER worker

# Run Celery worker with concurrency settings
CMD celery -A app.tasks.celery_app worker \
    --loglevel=info \
    --concurrency=2 \
    --max-tasks-per-child=100 \
    --task-events \
    --without-gossip \
    --without-mingle \
    --without-heartbeat
