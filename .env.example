# ===================================================
# Meta-Analysis Research Platform - Environment Variables
# ===================================================
# For Railway deployment instructions, see RAILWAY_SETUP.md
#
# IMPORTANT: Never commit actual secrets to version control!
# ===================================================

# ===================================================
# API KEYS (REQUIRED)
# ===================================================
# Anthropic API Key - REQUIRED for agent functionality
# Get your key from: https://console.anthropic.com/
# Format: sk-ant-api03-...
# Railway: Add this in the Variables tab of your service
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# OpenAI API Key - OPTIONAL (only if using OpenAI models)
# Get your key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# ===================================================
# DATABASE CONFIGURATION
# ===================================================
# PostgreSQL Database URL
# Local: postgresql://user:password@localhost:5432/meta_analysis
# Railway: Automatically provided via ${{DATABASE_URL}} reference variable
DATABASE_URL=postgresql://user:password@localhost:5432/meta_analysis

# Redis URL for caching and session storage
# Local: redis://localhost:6379/0
# Railway: Provision Redis plugin, URL automatically provided
REDIS_URL=redis://localhost:6379/0

# ===================================================
# VECTOR DATABASE
# ===================================================
# ChromaDB persistence directory
# Railway: Use /app/data/chroma for Railway persistent storage
CHROMA_PERSIST_DIR=./data/chroma

# ===================================================
# RESEARCH DATABASE APIs (OPTIONAL)
# ===================================================
# PubMed API Key - Get from: https://www.ncbi.nlm.nih.gov/account/
PUBMED_API_KEY=your_pubmed_api_key
PUBMED_EMAIL=your_email@example.com

# ===================================================
# APPLICATION CONFIGURATION
# ===================================================
# API Host - Use 0.0.0.0 to listen on all interfaces
API_HOST=0.0.0.0

# API Port - Railway automatically sets $PORT, defaults to 8000
API_PORT=8000

# Debug Mode - IMPORTANT: Set to false in production!
# Railway: Omit this variable or set to false
# Default: false (safe for production)
DEBUG=false

# Log Level - Options: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# ===================================================
# SECURITY (REQUIRED)
# ===================================================
# Secret Key - Generate a secure random key
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Railway: Add this in the Variables tab (keep it secret!)
SECRET_KEY=your-secret-key-here

# JWT Algorithm
ALGORITHM=HS256

# Access Token Expiration (in minutes)
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ===================================================
# FRONTEND CONFIGURATION
# ===================================================
# Frontend API URL
# Local: http://localhost:8000
# Railway: https://your-service-name.railway.app
NEXT_PUBLIC_API_URL=http://localhost:8000

# ===================================================
# CORS CONFIGURATION
# ===================================================
# Allowed Origins (comma-separated list)
# Railway: Add your Vercel frontend URL here
# Example: https://meta-analysis-tool.vercel.app,http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# ===================================================
# FEATURE FLAGS
# ===================================================
# Enable voice input/output features
ENABLE_VOICE=false

# Enable learning from user feedback
ENABLE_LEARNING=true

# Enable result verification against known meta-analyses
ENABLE_VERIFICATION=true

# ===================================================
# RAILWAY DEPLOYMENT NOTES
# ===================================================
# 1. REQUIRED Variables for Railway:
#    - ANTHROPIC_API_KEY (your API key from Anthropic)
#    - SECRET_KEY (generate a secure random key)
#
# 2. RECOMMENDED Settings:
#    - DEBUG=false (or omit entirely, defaults to false)
#    - LOG_LEVEL=INFO
#    - Add your Vercel frontend URL to ALLOWED_ORIGINS
#
# 3. DATABASE_URL is automatically provided by Railway's PostgreSQL plugin
#
# 4. PORT is automatically set by Railway, no need to configure
#
# For detailed setup instructions, see RAILWAY_SETUP.md
# ===================================================#
