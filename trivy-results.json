        {
          "VulnerabilityID": "CVE-2024-53981",
          "PkgName": "python-multipart",
          "PkgIdentifier": {
            "PURL": "pkg:pypi/python-multipart@0.0.6",
            "UID": "4e94f08afb217c0a"
