# Example Vercel environment variables template
# DO NOT commit actual secrets to git
# Copy this file to .env.vercel and fill in your actual values

# Supabase Configuration
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key-here"
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"

# Database Configuration (DO NOT COMMIT ACTUAL VALUES)
POSTGRES_DATABASE="postgres"
POSTGRES_HOST="your-database-host.supabase.co"
POSTGRES_PASSWORD="your-secure-password-here"
POSTGRES_PRISMA_URL="postgres://user:password@host:6543/postgres?sslmode=require&pgbouncer=true"
POSTGRES_URL="postgres://user:password@host:6543/postgres?sslmode=require&supa=base-pooler.x"
POSTGRES_URL_NON_POOLING="postgres://user:password@host:5432/postgres?sslmode=require"
POSTGRES_USER="postgres"

# Supabase Authentication (DO NOT COMMIT ACTUAL VALUES)
SUPABASE_ANON_KEY="your-supabase-anon-key-here"
SUPABASE_JWT_SECRET="your-jwt-secret-here"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key-here"
SUPABASE_URL="https://your-project.supabase.co"

# Vercel Configuration (DO NOT COMMIT ACTUAL VALUES)
VERCEL_OIDC_TOKEN="your-vercel-oidc-token-here"
